# Copy to .env for local use (`npm run dev`, `npm run serve`). Never commit a
# populated .env. On Vercel, set these in Project Settings -> Environment Variables.
#
# WARNING: never prefix a secret with VITE_ — Vite inlines VITE_* values into the
# public browser bundle. Everything below is read only by server code (api/*.ts,
# scripts/card-html.mjs) and must stay unprefixed.

# Public deployment origin: an exact HTTPS origin, no path and no trailing slash
# (e.g. https://card.example.com). Used for canonical/og:url/og:image, the
# sitemap, the vCard URL and the contact Origin check. Leave empty until the real
# domain is confirmed: builds then stay noindex and no domain is invented.
SITE_ORIGIN=

# Direct contact delivery. Off until the provider, retention period and privacy
# notice are approved. While off (or if anything below is missing or invalid)
# GET /api/contact reports {"enabled":false} and every POST is refused: 403 when
# SITE_ORIGIN is empty or invalid (the origin cannot be verified), otherwise 503.
# The page offers an email draft instead.
CONTACT_ENABLED=false

# Must equal DIRECT_DELIVERY_NOTICE in src/card/logic.ts, which stays null until
# the privacy notice (src/card/Privacy.tsx) describes direct delivery. While it is
# null, delivery cannot be enabled whatever this file says.
PRIVACY_NOTICE_VERSION=

# Resend (email delivery). Server-side only.
RESEND_API_KEY=
# Mailbox that receives messages.
CONTACT_TO=
# Verified sender, e.g. "QR card <card@your-verified-domain.example>".
CONTACT_FROM=

# Upstash Redis REST endpoint (https://...) and token for the shared rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random secret (at least 16 characters; 32+ recommended) used to HMAC
# client addresses for rate-limit keys and to derive provider idempotency keys.
RATE_LIMIT_SECRET=

# Rate-limit policy: attempts per window, per client.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Global ceiling across all clients together (stops address-rotation floods).
RATE_LIMIT_GLOBAL_MAX=50
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=86400
